# /etc/dzen-autopilot.env — real file lives only on the server, never commit
# a filled-in copy. Edit with deploy/robocall/configure.sh <KEY> <VALUE>, which
# restarts the service for you.

# --- required: pick ONE LLM provider -----------------------------------
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
LLM_EFFORT=medium

# --- required: Telegram ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID is captured automatically from your first /start — leave empty.
TELEGRAM_CHAT_ID=

# --- publishing -------------------------------------------------------
PUBLISH_MODE=publish
PUBLISH_WINDOW_START=08:00
PUBLISH_WINDOW_END=23:00
REPORT_HOUR=21
QUEUE_DEPTH=3
IMAGES_PER_ARTICLE=2
ARTICLE_MIN_CHARS=3000
ARTICLE_TARGET_CHARS=5500
ARTICLE_MAX_CHARS=9000
TIMEZONE=Europe/Moscow

# --- remote login portal -----------------------------------------------
LOGIN_PUBLIC_URL=https://dzen-login.31-76-40-61.sslip.io
LOGIN_NOVNC_PORT=6080
LOGIN_VNC_PORT=5901
LOGIN_BIND_ADDR=172.17.0.1

# --- paths --------------------------------------------------------------
DATA_DIR=/opt/dzen-autopilot/data
BROWSER_PROFILE_DIR=/opt/dzen-autopilot/data/profile
